# Local development defaults. No credentials belong in tracked files.
PORT=2567
HOST=127.0.0.1

# Startup validates this pre-migrated private schema; it never creates tables.
DATABASE_URL=
DATABASE_CA_FILE=
DATABASE_SCHEMA=enochian_chess

# Public Auth configuration; PostgreSQL credentials remain server-only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated supported sign-in methods. Use github for GitHub-only sign-in.
MULTIPLAYER_SIGNIN_PROVIDERS=email

# Explicit ranked admission opt-in. Requires valid public Auth configuration.
# Four freshly verified distinct accounts are still required; no guests or bots.
MULTIPLAYER_RANKED_ENABLED=false
# Global simultaneous unstarted lobby cap (integer 1–256; default 64).
# Saturation rejects new creates with lobby_capacity/HTTP 429; existing rooms stay available.
MULTIPLAYER_MAX_UNSTARTED_LOBBIES=64

# Required for production. Public endpoint/origins contain no credentials.
MULTIPLAYER_PUBLIC_ENDPOINT=
MULTIPLAYER_ALLOWED_ORIGINS=
MULTIPLAYER_INGRESS_POLICY=railway-edge-only
# Top-level sign-in navigation and authenticated native SDKs omit Origin.
# Opaque Origin: null is always rejected, even when this is true.
MULTIPLAYER_ALLOW_MISSING_ORIGIN=true

# Explicit isolated external test target only. Never use production/public data.
# The opt-in suite creates/removes only a unique enochian_probe_<uuid> schema.
TEST_DATABASE_URL=
TEST_DATABASE_CA_FILE=
TEST_DATABASE_ISOLATED=0
